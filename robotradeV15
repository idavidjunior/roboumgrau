function obterPrecoAtivoAtual(ativo) {
  const basePrice = 10 + Math.random() * 990;
  const hash = ativo.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const priceVariation = hash % 100 / 100;
  return basePrice * (1 + priceVariation);
}
function logSystemEvent(message, type = 'info', details = {}) {
  const systemLog = document.getElementById('system-log');
  if (!systemLog) return;

  const timestamp = new Date().toLocaleTimeString();
  const logEntry = document.createElement('div');
  logEntry.className = `log-entry log-${type}`;

  const colors = {
    info: '#00ff00',
    warning: '#ffff00',
    error: '#ff0000',
    success: '#00ff00',
    trade: '#00ffff',
    analysis: '#ff00ff',
    neural: '#0088ff'
  };

  // Formata detalhes adicionais
  let detailsHtml = '';
  if (Object.keys(details).length > 0) {
    detailsHtml = '<div style="margin-left: 20px; font-size: 0.9em;">';
    for (const [key, value] of Object.entries(details)) {
      detailsHtml += `<div>${key}: <span style="color: #88ff88">${value}</span></div>`;
    }
    detailsHtml += '</div>';
  }

  // Adiciona ícones baseados no tipo de mensagem
  const icons = {
    info: '🔵',
    warning: '⚠️',
    error: '❌',
    success: '✅',
    trade: '💹',
    analysis: '📊',
    neural: '🧠'
  };

  // Formata mensagem principal com ícone e timestamp
  const icon = icons[type] || '🔷';
  
  logEntry.innerHTML = `
    <div style="display: flex; align-items: start; margin-bottom: 5px;">
      <span style="margin-right: 8px;">${icon}</span>
      <div>
        <span style="color: #888888">[${timestamp}]</span>
        <span style="color: ${colors[type] || colors.info}"> ${message}</span>
        ${detailsHtml}
      </div>
    </div>
  `;

  // Adiciona efeitos visuais para eventos importantes
  if (type === 'trade' || type === 'neural') {
    logEntry.style.animation = 'fadeInOut 0.5s';
  }

  // Adiciona indicadores de performance quando relevante
  if (type === 'trade' && details.lucro) {
    const performanceIndicator = document.createElement('div');
    performanceIndicator.style.height = '3px';
    performanceIndicator.style.width = '100%';
    performanceIndicator.style.backgroundColor = parseFloat(details.lucro) > 0 ? '#00ff00' : '#ff0000';
    performanceIndicator.style.marginTop = '2px';
    logEntry.appendChild(performanceIndicator);
  }

  // Adiciona a entrada no início do log
  systemLog.insertBefore(logEntry, systemLog.firstChild);

  // Mantém um limite de 1000 entradas no log
  while (systemLog.children.length > 1000) {
    systemLog.removeChild(systemLog.lastChild);
  }

  // Atualiza contadores e estatísticas
  atualizarEstatisticasLog(type);
}

