    alert(`Reinvestimento de R$ ${reinvestimentoValor.toFixed(2)} realizado.\nTransferência de R$ ${valorTransferencia.toFixed(2)} efetuada.`);
  } else {
    saldoTransferido += valorLucro;
    saldoLiquido -= valorLucro;
