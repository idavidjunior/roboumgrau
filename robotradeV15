function verificarLimitesOperacao() {
  const modoOperacao = document.getElementById('modo-operacao').value;
  const limiteOperacoesInput = document.getElementById('limite-operacoes');
  const metaLucroInput = document.getElementById('meta-lucro');
  const limiteDisponivel = investimentoInicial - calcularMargemRequerida();
  switch (modoOperacao) {
    case 'limite-operacoes':
      const limiteOperacoes = parseInt(limiteOperacoesInput.value);
      if (!isNaN(limiteOperacoes) && totalOperacoes >= limiteOperacoes) {
        pararRobo();
        const lucro = saldoLiquido - investimentoInicial;
        if (lucro > 0) {
          const reinvestir = confirm(`Limite de ${limiteOperacoes} operações atingido!\nDeseja reinvestir parte do lucro de R$ ${lucro.toFixed(2)}?`);
          if (reinvestir) {
            const valorReinvestimento = prompt(`Digite o valor que deseja reinvestir do lucro total de R$ ${lucro.toFixed(2)}:`);
            const reinvestimentoValor = parseFloat(valorReinvestimento);
            if (isNaN(reinvestimentoValor) || reinvestimentoValor < 0 || reinvestimentoValor > lucro) {
              alert('Valor inválido. Por favor, digite um valor entre 0 e ' + lucro.toFixed(2));
              return;
            }
            const operacao = {
              timestamp: new Date().toLocaleString(),
              tipo: 'Reinvestimento',
              valor: reinvestimentoValor,
              saldoAnterior: investimentoInicial,
              transferencia: lucro - reinvestimentoValor
            };
            investimentoInicial = reinvestimentoValor;
            saldoTransferido += lucro - reinvestimentoValor;
            saldoLiquido = reinvestimentoValor;
            totalOperacoes = 0;
            operacoesSucesso = 0;
            numAcertos = 0;
            numErros = 0;
            acertosConsecutivos = 0;
            errosConsecutivos = 0;
            consecutiveErrorsForStrategy = 0;
            adicionarLogOperacao({
              timestamp: operacao.timestamp,
              tipo: 'Reinvestimento e Transferência',
              ativo: 'Sistema',
              quantidade: 1,
              preco: reinvestimentoValor,
              total: lucro
            });
            alert(`Operação realizada:\nReinvestimento: R$ ${reinvestimentoValor.toFixed(2)}\nTransferência: R$ ${(lucro - reinvestimentoValor).toFixed(2)}`);
          } else {
            saldoTransferido += lucro;
            saldoLiquido = investimentoInicial;
            alert(`Transferência total de R$ ${lucro.toFixed(2)} efetuada.`);
          }
          atualizarSaldos();
          atualizarEstatisticas();
          atualizarLog();
          return;
          } else {
          alert('Limite de operações atingido! Não há lucro para transferência.');
        }
      }
      break;
    case 'limite-disponivel':
      if (limiteDisponivel <= 0) {
        pararRobo();
        const lucro = saldoLiquido - investimentoInicial;
        if (lucro > 0) {
          promptLucroAction(lucro);
        } else {
          alert('Limite disponível zerado! Não há lucro para transferência.');
          atualizarSaldos();
          atualizarEstatisticas();
          atualizarLog();
          
        }
      }
      break;
    case 'meta-lucro':
      const metaLucro = parseFloat(metaLucroInput.value);
      if (!isNaN(metaLucro) && saldoLiquido - investimentoInicial >= metaLucro) {
        pararRobo();
        promptLucroAction(metaLucro);
        } else {
        alert('Meta de lucro atingida! Não há lucro para transferência.');
        atualizarSaldos();
        atualizarEstatisticas();
        atualizarLog();
      }
      break;
  }
}
