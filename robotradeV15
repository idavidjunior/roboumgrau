function realizarTransferencia(valor) {
  logSystemEvent(`Iniciando transferência de R$ ${valor.toFixed(2)}...`, 'info');
  let allocationAmount;
  const modoTransferencia = document.getElementById('transferencia-automatica').value;
  const transferenciaTotal = document.getElementById('transferencia-total').checked;
  if (modoTransferencia === 'manual') {
    return;
  }
  if (modoTransferencia === 'habilitado') {
    if (transferenciaTotal) {
      allocationAmount = 0;
    } else {
      allocationAmount = valor * 0.2;
    }
  } else {
    allocationAmount = promptInvestmentAllocation(valor);
    if (allocationAmount === null) {
      return;
    }
  }
  investimentoInicial += allocationAmount;
  const transferAmount = valor - allocationAmount;
  saldoTransferido += transferAmount;
  saldoLiquido -= valor;
  const operationInfoPanel = document.getElementById('operation-info-panel');
  if (operationInfoPanel) {
    const transferInfo = document.createElement('div');
    transferInfo.className = 'transfer-info';
    transferInfo.innerHTML = `
      <h4>Última Transferência</h4> 
      <div class="transfer-detail">
        <p>Valor Transferido: R$ ${transferAmount.toFixed(2)}</p>
        <p>Alocado para Investimento: R$ ${allocationAmount.toFixed(2)}</p>
      </div>
    `;
    operationInfoPanel.appendChild(transferInfo);
    const existingInfo = operationInfoPanel.querySelector('.transfer-info');
    if (existingInfo) {
      existingInfo.remove();
    }
    operationInfoPanel.insertBefore(transferInfo, operationInfoPanel.querySelector('.operation-limits'));
  }
  const ultimaTransferenciaElement = document.getElementById('ultima-transferencia');
  if (ultimaTransferenciaElement) {
    ultimaTransferenciaElement.innerHTML = `
      <p>Última Transferência: R$ ${transferAmount.toFixed(2)}</p>
      <p>Alocado para Investimento: R$ ${allocationAmount.toFixed(2)}</p>
      <p>Saldo Liquido: R$ ${saldoLiquido.toFixed(2)}</p>
    `;
  } else {
    console.warn("Elemento 'ultima-transferencia' não encontrado.");
  }
  const investimentoInicialValor = document.getElementById('investimento-inicial-valor');
  if (investimentoInicialValor) {
    investimentoInicialValor.textContent = `R$ ${investimentoInicial.toFixed(2)}`;
  }
  const investimentoInicialInput = document.getElementById('investimento-inicial');
  if (investimentoInicialInput) {
    investimentoInicialInput.value = investimentoInicial.toFixed(2);
  }
  logSystemEvent(`Transferência de R$ ${transferAmount.toFixed(2)} realizada com sucesso.`, 'success');
  atualizarSaldos();
}
