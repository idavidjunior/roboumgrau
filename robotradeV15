function calcularCorrelacaoMedia(metricas) {
  return metricas.reduce((acc, m) => acc + m.correlacao, 0) / metricas.length;
}

function calcularQuantidadeAcoes(valorDisponivel, precoAcao) {
  if (!precoAcao || precoAcao <= 0) {
    return {
      quantidade: 0,
      valorRestante: valorDisponivel
    };
  }
  const quantidade = Math.floor(valorDisponivel / precoAcao);
  const valorRestante = valorDisponivel - quantidade * precoAcao;
  return {
    quantidade,
    valorRestante
  };
}
function obterPrecoAtivoAtual(ativo) {
  const basePrice = 10 + Math.random() * 990;
  const hash = ativo.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const priceVariation = hash % 100 / 100;
  return basePrice * (1 + priceVariation);
}
