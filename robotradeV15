  let existingIndex = algorithmRegistry.findIndex(item => item.name === name);

  if (existingIndex > -1) {
    // Algoritmo já existe: atualiza e move para o final
    let existing = algorithmRegistry[existingIndex];
    existing.lastUpdated = now;
    existing.status = "Reutilizado";
    // Remove e adiciona para mover ao final
    algorithmRegistry.splice(existingIndex, 1);
    algorithmRegistry.push(existing);
    updateAlgorithmDisplay(existing, false);
    return existing;
  } else {
    // Algoritmo novo
    let newRecord = {
      id: "alg_" + now.getTime(),
      name: name,
      description: description,
      timestamp: now,
      status: "Novo"
    };

    // Se o limite for atingido, remove o mais antigo
    if (algorithmRegistry.length >= maxAlgorithmSlots) {
      algorithmRegistry.shift();
    }

    algorithmRegistry.push(newRecord);
    updateAlgorithmDisplay(newRecord, true);
    return newRecord;
  }
}

function updateAlgorithmDisplay(targetRecord, isNew) {
  const container = document.getElementById('new-algorithm');
  if (!container) return;

  container.innerHTML = ""; // Limpa o container
  
  algorithmRegistry.forEach(record => {
    const itemDiv = document.createElement('div');
    
    // Define o estilo base do div baseado no status
    if (record.status === "Reutilizado") {
      itemDiv.style.backgroundColor = "#000000";
      itemDiv.style.color = "#ffffff";
      itemDiv.style.border = "2px solid #333333";
    }

    // Define o conteúdo do div
    itemDiv.innerHTML = `
      <strong style="color: ${record.status === "Reutilizado" ? "#ffffff" : "inherit"}">${record.name}</strong><br>
      <small style="color: ${record.status === "Reutilizado" ? "#ffffff" : "inherit"}">${record.timestamp.toLocaleTimeString()}</small><br>
      <em style="color: ${record.status === "Reutilizado" ? "#ffffff" : "inherit"}">${record.status}</em><br>
      <p style="margin:4px 0 0; font-size:10px; color:${record.status === "Reutilizado" ? "#ffffff" : "#555"};">${record.description}</p>
    `;

    // Aplica efeito de piscar apropriado
    if (targetRecord && record.id === targetRecord.id) {
      if (record.status === "Reutilizado") {
        itemDiv.classList.add('blink-reused');
      } else if (isNew) {
        itemDiv.classList.add('blink-new');
      }
    }

    container.appendChild(itemDiv);
    container.scrollTop = container.scrollHeight;
  });
}

