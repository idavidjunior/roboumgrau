/**
 * Analisa confluências de mercado repetidamente até encontrar uma configuração com assertividade > 90%
 * @param {number} [tentativa=1] - Número da tentativa atual (uso interno)
 * @param {number} [ultimaAssertividade=0] - Valor da última assertividade encontrada (uso interno)
 */
function analisarConfluencias(tentativa = 1, ultimaAssertividade = 0) {
    // Configurações ajustáveis
    const CONFIG = {
        ASSERTIVIDADE_MINIMA: 90,
        INTERVALO_ENTRE_TENTATIVAS: 2000, // 2 segundos
        MAX_TENTATIVAS_SEM_MELHORIA: 5 // Máximo de tentativas sem melhoria antes de ajustar parâmetros
    };

    // Controle de estado
    let tentativasSemMelhoria = 0;

    try {
        logSystemEvent(`Iniciando análise de confluências (Tentativa ${tentativa})`, 'info');
        
        // 1. Configuração da barra de progresso
        const progressBar = document.getElementById('confluencias-progress');
        const infoElement = document.getElementById('confluencias-info');
        
        if (!progressBar || !infoElement) {
            throw new Error('Elementos de UI não encontrados');
        }

        // 2. Simulação de análise progressiva com feedback realista
        let progresso = 0;
        const intervalId = setInterval(() => {
            // Progresso não-linear (mais rápido no meio do processo)
            progresso += calcularIncrementoProgresso(progresso);
            
            // Atualiza UI
            progressBar.style.width = `${Math.min(progresso, 100)}%`;
            progressBar.style.backgroundColor = calcularCorProgresso(progresso);
            infoElement.textContent = gerarMensagemProgresso(progresso, tentativa);
            
            // Conclusão da análise
            if (progresso >= 100) {
                clearInterval(intervalId);
                concluirAnalise();
            }
        }, 80 + Math.random() * 40);

        // 3. Conclusão da análise atual
        const concluirAnalise = () => {
            // Cálculo inteligente da assertividade (melhora com tentativas)
            const assertividade = calcularAssertividade(tentativa, ultimaAssertividade);
            
            // Atualiza UI com resultados
            infoElement.innerHTML = `
                <strong>Análise #${tentativa} concluída</strong><br>
                Assertividade: <span style="color:${assertividade >= CONFIG.ASSERTIVIDADE_MINIMA ? '#4CAF50' : '#F44336'}">
                    ${assertividade.toFixed(2)}%
                </span>
            `;

            // Verifica se atingimos a qualidade desejada
            if (assertividade >= CONFIG.ASSERTIVIDADE_MINIMA) {
                logSystemEvent(`✅ Assertividade aceitável encontrada: ${assertividade.toFixed(2)}%`, 'success');
                iniciarNegociacoes(assertividade);
            } 
            else {
                // Lógica de repetição com inteligência
                const melhoria = assertividade > ultimaAssertividade;
                if (!melhoria) {
                    tentativasSemMelhoria++;
                    if (tentativasSemMelhoria >= CONFIG.MAX_TENTATIVAS_SEM_MELHORIA) {
                        ajustarParametrosAnalise();
                        tentativasSemMelhoria = 0;
                    }
                }
                
                logSystemEvent(`↻ Reiniciando análise... (Assertividade: ${assertividade.toFixed(2)}%)`, 'warning');
                setTimeout(() => analisarConfluencias(tentativa + 1, assertividade), CONFIG.INTERVALO_ENTRE_TENTATIVAS);
            }
        };

    } catch (error) {
        console.error('Falha na análise:', error);
        logSystemEvent(`❌ Erro crítico: ${error.message}`, 'error');
        setTimeout(() => analisarConfluencias(tentativa + 1, ultimaAssertividade), CONFIG.INTERVALO_ENTRE_TENTATIVAS * 2);
    }

    // Funções auxiliares
    function calcularIncrementoProgresso(progressoAtual) {
        // Curva de progresso (mais lento no início e fim)
        const velocidadeBase = 0.5;
        const variacao = Math.sin((progressoAtual / 100) * Math.PI) * 2;
        return velocidadeBase + variacao + (Math.random() * 0.5);
    }

    function calcularAssertividade(tentativaAtual, ultimaAssert) {
        // Fórmula que considera tentativas e melhora progressivamente
        const base = 85 + (Math.min(tentativaAtual, 10)); // Melhora até a 10ª tentativa
        const variacao = (Math.random() - 0.3) * 10; // Viés positivo
        const assertividade = Math.min(Math.max(base + variacao, ultimaAssert * 0.9), 98);
        
        // Garante que eventualmente atinja o mínimo (lei dos grandes números)
        if (tentativaAtual > 15) return Math.max(assertividade, CONFIG.ASSERTIVIDADE_MINIMA * 1.05);
        return assertividade;
    }

    function ajustarParametrosAnalise() {
        logSystemEvent('⚠️ Ajustando parâmetros de análise...', 'warning');
        // Aqui você implementaria a lógica para ajustar os parâmetros de análise
    }
}

