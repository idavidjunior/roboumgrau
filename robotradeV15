      <script>
          const apiUrls = {
              binance: 'https://api.binance.com/api/v3/account',
              outra: 'https://api.outracorretora.com/connect'
          };
      
          const connectionHistory = {};
      
          async function conectarCorretora() {
              const apiKey = document.getElementById('api-key').value;
              const secretKey = document.getElementById('secret-key').value;
              const corretora = document.getElementById('corretora').value;
      
              if (!apiKey || !secretKey || !corretora) {
                  showStatus('Preencha todos os campos antes de conectar!', 'error');
                  return;
              }
      
              const attemptId = Date.now();
              const connectionAttempt = {
                  timestamp: new Date(),
                  corretora,
                  status: 'pending',
                  error: null,
                  solution: null
              };
      
              try {
                  if (connectionHistory[corretora]) {
                      connectionHistory[corretora].solutions.forEach(solution => {
                          if (solution.conditionsMet()) solution.apply();
                      });
                  }
      
                  const response = await fetch('/connect_broker', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ apiKey, secretKey, corretora, attemptId })
                  });
      
                  const data = await response.json();
      
                  if (response.ok) {
                      connectionAttempt.status = 'success';
                      showStatus('Conexão bem-sucedida!', 'success');
                  } else {
                      throw new Error(data.message || 'Erro na conexão');
                  }
              } catch (error) {
                  connectionAttempt.status = 'failed';
                  connectionAttempt.error = error;
                  showStatus('Erro na conexão: ' + error.message, 'error');
      
                  const solution = analyzeErrorAndProposeSolution(error);
                  if (solution) {
                      connectionAttempt.solution = solution;
                      if (!connectionHistory[corretora]) {
                          connectionHistory[corretora] = { attempts: [], solutions: [] };
                      }
                      connectionHistory[corretora].solutions.push(solution);
                      solution.apply();
                      return conectarCorretora();
                  }
              }
          }
      
          function analyzeErrorAndProposeSolution(error) {
              const errorType = identifyErrorType(error);
              const solutions = {
                  timeout: {
                      description: 'Aumentar tempo limite de conexão',
                      apply: () => console.log('Aumentando timeout...')
                  },
                  auth: {
                      description: 'Verificar chaves de API',
                      apply: () => console.log('Verificando chaves...')
                  },
                  network: {
                      description: 'Verificar conexão de rede',
                      apply: () => console.log('Verificando rede...')
                  }
              };
              return solutions[errorType] || null;
          }
      
          function identifyErrorType(error) {
              if (error.message.includes('timeout')) return 'timeout';
              if (error.message.includes('authentication')) return 'auth';
              if (error.message.includes('network')) return 'network';
              return 'unknown';
          }
      
          function showStatus(message, type) {
              const statusElement = document.getElementById('connection-status');
              statusElement.textContent = message;
              statusElement.className = `status-${type}`;
          }
      
          function desconectarCorretora() {
              showStatus('Desconectado', 'disconnected');
          }
      </script>
      


  


