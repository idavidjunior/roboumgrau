      <script>
        function updateNeuralMap() {
          const canvas = document.getElementById('neural-connections');
          const ctx = canvas.getContext('2d');
          const neurons = document.querySelectorAll('.neuron');
          
          // Ajusta o tamanho do canvas para corresponder ao tamanho do container
          canvas.width = canvas.offsetWidth;
          canvas.height = canvas.offsetHeight;
          
          // Limpa o canvas
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          // Atualiza estado dos neurônios
          neurons.forEach(neuron => {
            neuron.classList.toggle('active', Math.random() > 0.5);
          });
          
          // Desenha conexões
          const activeNeurons = document.querySelectorAll('.neuron.active');
          ctx.strokeStyle = '#00ff88';
          ctx.lineWidth = 0.5;
          
          activeNeurons.forEach(source => {
            const sourceRect = source.getBoundingClientRect();
            const mapRect = canvas.getBoundingClientRect();
            
            activeNeurons.forEach(target => {
              if (source !== target && Math.random() > 0.8) {
                const targetRect = target.getBoundingClientRect();
                
                ctx.beginPath();
                ctx.moveTo(
                  sourceRect.left - mapRect.left + sourceRect.width/2,
                  sourceRect.top - mapRect.top + sourceRect.height/2
                );
                
                // Curva de Bezier para conexões mais suaves
                const controlX = (sourceRect.left + targetRect.left) / 2 - mapRect.left;
                const controlY = (sourceRect.top + targetRect.top) / 2 - mapRect.top;
                
                ctx.quadraticCurveTo(
                  controlX,
                  controlY,
                  targetRect.left - mapRect.left + targetRect.width/2,
                  targetRect.top - mapRect.top + targetRect.height/2
                );
                
                ctx.globalAlpha = 0.2;
                ctx.stroke();
              }
            });
          });
        }

        // Atualiza a cada segundo (apenas quando o robô estiver ligado)
        if (neuralMapIntervalId) {
          clearInterval(neuralMapIntervalId);
        }
        neuralMapIntervalId = setInterval(() => {
          if (roboLigado) {
            updateNeuralMap();
          }
        }, 1000);

        // Inicializa ao carregar
        document.addEventListener('DOMContentLoaded', () => {
          updateNeuralMap();
          // Atualiza quando a janela é redimensionada
          window.addEventListener('resize', updateNeuralMap);
        });
      </script>
